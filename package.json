{
  "name": "moonlens",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "PC-resident Google Lens-style tool: OCR translate, QR, reverse image search, live subtitles, with local LLM and plugins.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:grid": "node scripts/ui-audit/grid-audit.mjs build",
    "audit:overflow": "node scripts/ui-audit/overflow-audit.mjs build",
    "audit:overflow:en": "node scripts/ui-audit/overflow-audit.mjs build --langs en --sizes medium,xlarge",
    "audit:select": "node scripts/ui-audit/select-contrast.mjs build",
    "audit:player": "node scripts/ui-audit/player-check.mjs build",
    "audit:i18n": "node scripts/ui-audit/i18n-audit.mjs build --lang en && node scripts/ui-audit/i18n-audit.mjs build --lang ja",
    "lint:copy": "node scripts/copy-lint.mjs",
    "lint:i18n": "node scripts/i18n-lint.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tauri-apps/cli": "^2.12.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^22.0.0",
    "@vitest/ui": "^4.1.4",
    "autoprefixer": "^10.4.0",
    "happy-dom": "^20.9.0",
    "playwright": "^1.63.0",
    "postcss": "^8.4.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "lucide-svelte": "^0.460.0",
    "motion": "^11.0.0"
  }
}
