# Rust / Tauri
target/
src-tauri/target/
# Secondary cargo target dir used when the main `target/` is locked
# by a running app instance during development.
src-tauri/target-test/
src-tauri/gen/
# cargo-component generates bindings.rs on build; regenerated by
# `cargo component build` so do not commit.
src-tauri/tests/fixtures/wasm-hello/src/bindings.rs
# Cargo.lock is committed: this repo ships executables, so we want
# byte-identical dependency resolution across CI runners and platforms.

