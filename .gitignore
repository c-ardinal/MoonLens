# Node
node_modules/
dist/
.svelte-kit/
build/
.vite/

# Rust / Tauri
target/
src-tauri/target/
# Secondary cargo target dir used when the main `target/` is locked
# by a running app instance during development.
src-tauri/target-test/
src-tauri/gen/
# cargo-component generates bindings.rs on build; regenerated by
# `cargo component build` so do not commit.
src-tauri/tests/fixtures/wasm-hello/src/bindings.rs
# Cargo.lock is committed: this repo ships executables, so we want
# byte-identical dependency resolution across CI runners and platforms.

# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Env / secrets
.env
.env.*
!.env.example

# MoonLens runtime
/data/
*.moonlens-plugin
plugins-installed/
logs/
.gstack/
.playwright-mcp/

# Local conversion toolchain (clone of llama.cpp + venv for
# convert_hf_to_gguf.py). Used by ad-hoc model conversion work
# (see docs/benchmarks/2026-05-12-phase26-* for rationale); not
# required for runtime builds.
tools/

# Benchmark fixtures (captured from user's screen; may contain PII —
# regenerate with `cargo run --example bench_speed --release`).
src-tauri/tests/fixtures/bench/*.png

# Lens evaluation outputs (generated by `cargo run --example
# lens_eval --release` and the `scripts/run-lens-eval-3way.ps1`
# harness). The PNG / JSON / markdown artifacts are reproducible
# from the bundled input fixtures, so checking them in would just
# bloat the diff every time someone re-benches.
tests/output/
tests/output_3way/
tests/output_pre_eos_fix/

# Vite's dev-server cache timestamp file. Picked up by node's ESM
# loader for HMR; rotates on every restart and is never useful in
# git history.
vite.config.ts.timestamp-*.mjs

# Claude Code session state (per-developer scratch dir; not a
# project artifact).
.claude/

# Vulkan profile dumps (`vulkaninfo --html` or the LunarG capture
# tool produces these). Host-specific GPU capability snapshots —
# helpful for debugging a single user's driver, never useful in
# the shared repo history.
VP_VULKANINFO_*.json
