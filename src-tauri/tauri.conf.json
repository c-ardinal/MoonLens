{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoonLens",
  "version": "0.1.0",
  "identifier": "io.moonlens.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "MoonLens",
        "width": 1280,
        "height": 800,
        "minWidth": 1120,
        "minHeight": 700,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "MoonLens Overlay",
        "width": 480,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "url": "/overlay"
      },
      {
        "label": "subtitle",
        "title": "MoonLens Subtitle",
        "width": 900,
        "height": 160,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "focus": false,
        "visible": false,
        "url": "/subtitle"
      },
      {
        "label": "live",
        "title": "MoonLens Live",
        "width": 400,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "visible": false,
        "url": "/live"
      },
      {
        "label": "selector",
        "title": "MoonLens Selector",
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": true,
        "visible": false,
        "fullscreen": false,
        "url": "/select"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Guren",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": { "depends": ["libvulkan1"] },
      "rpm": { "depends": ["vulkan-loader"] }
    },
    "shortDescription": "On-device screen OCR and translation",
    "longDescription": "A resident tool that reads text in any screen region and paints the translation in place, fully on-device: OCR and translation run on local models and nothing is sent over the network. Also decodes QR codes, explains and summarizes text, and supports plugins."
  },
  "plugins": {}
}
