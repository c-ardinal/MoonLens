{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoonLens",
  "version": "0.1.0",
  "identifier": "io.moonlens.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MoonLens",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "MoonLens Overlay",
        "width": 480,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "url": "/overlay"
      },
      {
        "label": "subtitle",
        "title": "MoonLens Subtitle",
        "width": 900,
        "height": 160,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "focus": false,
        "visible": false,
        "url": "/subtitle"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Lens-style OCR, translate, QR and live subtitles",
    "longDescription": "A resident, privacy-first tool that captures any screen region or window audio to deliver OCR translation, QR decoding, reverse image search and live subtitles. Powered by local LLMs with cloud fallback, and a plugin system for user-authored extensions."
  },
  "plugins": {}
}
